{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroStudy",
  "mainBinaryName": "zerostudy",
  "version": "0.1.0",
  "identifier": "dev.raulplz.zerostudy",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../crates/ui", "wait": false },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../crates/ui" },
    "frontendDist": "../crates/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": false,
    "category": "Education",
    "shortDescription": "Repaso espaciado, atlas de conceptos y plazos sobre tus apuntes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
